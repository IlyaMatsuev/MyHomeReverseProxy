{
  "name": "my-reverse-proxy",
  "private": true,
  "version": "1.0.0",
  "description": "The project contains settings and configurations required for running a reverse proxy on the local server.",
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "prettier": "prettier --write",
    "prettier:verify": "prettier --list-different",
    "traefik:start": "docker compose up traefik -d",
    "traefik:restart": "docker compose up traefik -d --force-recreate",
    "pihole:start": "docker compose up pihole -d",
    "pihole:restart": "docker compose up -d --force-recreate"
  },
  "author": {
    "name": "Ilya Matsuev",
    "email": "ilya.matsuev.business@proton.me",
    "url": "https://github.com/IlyaMatsuev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IlyaMatsuev/MyReverseProxy"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "**/*.{html,js,ts,css,xml,yaml,yml,json,md}": [
      "npm run prettier"
    ]
  }
}
