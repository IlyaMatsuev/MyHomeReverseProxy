{
  "name": "my-reverse-proxy",
  "private": true,
  "version": "1.0.0",
  "description": "The project contains settings and configurations required for running a reverse proxy on the local server.",
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "prettier": "prettier --write",
    "prettier:verify": "prettier --list-different",
    "traefik:setup": "sh ./traefik/scripts/setup.sh",
    "traefik:start": "npm run traefik:setup && docker compose up traefik -d",
    "traefik:restart": "npm run traefik:setup && docker compose up traefik -d --force-recreate",
    "traefik:token:generate": "bash ./traefik/scripts/generate_token.sh",
    "pihole:setup": "sh ./pihole/scripts/setup.sh",
    "pihole:start": "npm run pihole:setup && docker compose up pihole -d",
    "pihole:restart": "npm run pihole:setup && docker compose up pihole -d --force-recreate",
    "arp-scan": "sudo bash ./utils/arp-scan/arp-scan.sh",
    "arp-scan:schedule": "sudo bash ./utils/arp-scan/schedule.sh",
    "duckdns:update-ip": "bash ./utils/duckdns/update_ip.sh",
    "duckdns:update-ip:schedule": "bash ./utils/duckdns/schedule_update_ip.sh",
    "ssh:setup:client": "bash ./utils/ssh/setup_client.sh",
    "ssh:setup:server": "sudo bash ./utils/ssh/setup_server.sh",
    "ssh:verify": "bash ./utils/ssh/verify.sh"
  },
  "author": {
    "name": "Ilya Matsuev",
    "email": "ilya.matsuev.business@proton.me",
    "url": "https://github.com/IlyaMatsuev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IlyaMatsuev/MyReverseProxy"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "**/*.{html,js,ts,css,xml,yaml,yml,json,md}": [
      "npm run prettier"
    ]
  }
}
