# General
TZ=

# Network
ROUTER_IP=192.168.0.1
LAN_SUBNET=192.168.0.0/24

# Domain
DOMAIN=mydomain.duckdns.org
DUCKDNS_TOKEN=my-token

# Auth: the header with the token, it has to be different from Authorization, which the services use
PROXY_AUTH_HEADER=X-Proxy-Authorization
# Tokens for that header, comma-separated (e.g. one per app)
# Generate with "npm run traefik:token:generate [alias]"
# Multiple tokens can be split into lines inside double quotes:
# PROXY_API_KEY="token1,
#   token2"
PROXY_API_KEY=

# Pihole
PIHOLE_PORT_DNS=53
PIHOLE_PORT_HTTP=8080
PIHOLE_PORT_HTTPS=8443
